{
  "name": "@gk0919/agent-workflow",
  "version": "1.0.0",
  "private": false,
  "description": "面向编码智能体的可移植、Profile 驱动工作流引擎。",
  "type": "module",
  "types": "./dist/src/plugin-sdk/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/src/plugin-sdk/index.d.ts",
      "import": "./dist/src/plugin-sdk/index.js"
    },
    "./contracts": {
      "types": "./dist/src/contracts/index.d.ts",
      "import": "./dist/src/contracts/index.js"
    },
    "./execution": {
      "types": "./dist/src/execution/index.d.ts",
      "import": "./dist/src/execution/index.js"
    },
    "./plugin-sdk": {
      "types": "./dist/src/plugin-sdk/index.d.ts",
      "import": "./dist/src/plugin-sdk/index.js"
    },
    "./host-node": {
      "types": "./dist/src/host-node/index.d.ts",
      "import": "./dist/src/host-node/index.js"
    },
    "./host-rpc": {
      "types": "./dist/src/host-rpc/index.d.ts",
      "import": "./dist/src/host-rpc/index.js"
    },
    "./mcp": {
      "types": "./dist/src/mcp/index.d.ts",
      "import": "./dist/src/mcp/index.js"
    },
    "./plugins/mcp-source-provider": {
      "types": "./dist/src/plugins/mcp-source-provider/index.d.ts",
      "import": "./dist/src/plugins/mcp-source-provider/index.js"
    },
    "./plugins/mcp-source-provider/config.example.json": "./resources/plugins/mcp-source-provider/config.example.json",
    "./schemas/plugin-manifest.json": "./resources/schemas/plugin-manifest.schema.json",
    "./schemas/execution-event.json": "./resources/schemas/execution-event.schema.json",
    "./schemas/execution-workspace-state.json": "./resources/schemas/execution-workspace-state.schema.json",
    "./schemas/agent-executor-process.json": "./resources/schemas/agent-executor-process.schema.json",
    "./schemas/fake-executor-fixture.json": "./resources/schemas/fake-executor-fixture.schema.json",
    "./schemas/workflow-definition.json": "./resources/schemas/workflow-definition.schema.json",
    "./schemas/workflow-definition-bundle.json": "./resources/schemas/workflow-definition-bundle.schema.json",
    "./schemas/workflow-transition.json": "./resources/schemas/workflow-transition.schema.json",
    "./schemas/workflow-config.json": "./resources/schemas/workflow-config.schema.json",
    "./package.json": "./package.json"
  },
  "bin": {
    "agent-workflow": "./dist/bin/agent-workflow.js",
    "mcp-credential-helper": "./dist/bin/mcp-credential-helper.js"
  },
  "engines": {
    "node": ">=20"
  },
  "scripts": {
    "test": "npm run quality:policy",
    "clean": "rimraf dist",
    "build": "npm run clean && tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "workflow:classify": "node dist/bin/agent-workflow.js classify",
    "workflow:context": "node dist/bin/agent-workflow.js context",
    "workflow:execution:plan": "node dist/bin/agent-workflow.js execution:plan",
    "workflow:execution:adaptive:preview": "node dist/bin/agent-workflow.js execution:adaptive:preview",
    "workflow:execution:adaptive:run": "node dist/bin/agent-workflow.js execution:adaptive:run",
    "workflow:execution:adaptive:test": "node dist/bin/agent-workflow.js execution:adaptive:test",
    "workflow:execution:author:preview": "node dist/bin/agent-workflow.js execution:author:preview",
    "workflow:execution:author:save": "node dist/bin/agent-workflow.js execution:author:save",
    "workflow:execution:author:migrate": "node dist/bin/agent-workflow.js execution:author:migrate",
    "workflow:execution:author:run": "node dist/bin/agent-workflow.js execution:author:run",
    "workflow:execution:author:test": "node dist/bin/agent-workflow.js execution:author:test",
    "workflow:execution:run": "node dist/bin/agent-workflow.js execution:run",
    "workflow:execution:resume": "node dist/bin/agent-workflow.js execution:resume",
    "workflow:execution:pause": "node dist/bin/agent-workflow.js execution:pause",
    "workflow:execution:cancel": "node dist/bin/agent-workflow.js execution:cancel",
    "workflow:execution:parallel:run": "node dist/bin/agent-workflow.js execution:parallel:run",
    "workflow:execution:parallel:resume": "node dist/bin/agent-workflow.js execution:parallel:resume",
    "workflow:execution:portability:test": "node dist/bin/agent-workflow.js execution:portability:test",
    "workflow:execution:writable:test": "node dist/bin/agent-workflow.js execution:writable:test",
    "workflow:feedback": "node dist/bin/agent-workflow.js feedback",
    "workflow:init": "node dist/bin/agent-workflow.js init",
    "workflow:init:test": "node dist/bin/agent-workflow.js init:test",
    "workflow:knowledge": "node dist/bin/agent-workflow.js knowledge",
    "workflow:next": "node dist/bin/agent-workflow.js next",
    "workflow:profile": "node dist/bin/agent-workflow.js profile --check",
    "workflow:retention": "node dist/bin/agent-workflow.js retention",
    "workflow:route": "node dist/bin/agent-workflow.js route",
    "workflow:routes:docs": "node dist/bin/agent-workflow.js routes:docs",
    "workflow:routes:eval": "node dist/bin/agent-workflow.js routes:eval",
    "workflow:routes:test": "node dist/bin/agent-workflow.js routes:test",
    "workflow:task": "node dist/bin/agent-workflow.js task",
    "workflow:verify:ci": "node dist/bin/agent-workflow.js verify:ci",
    "workflow:verify:contract": "node dist/bin/agent-workflow.js verify:contract",
    "workflow:worktree": "node dist/bin/agent-workflow.js worktree",
    "quality:hooks:check": "node dist/bin/agent-workflow.js quality:hooks --check",
    "quality:hooks:setup": "node dist/bin/agent-workflow.js quality:hooks",
    "quality:js": "node dist/bin/agent-workflow.js quality:js",
    "quality:skills": "node dist/bin/agent-workflow.js quality:skills",
    "quality:staged": "node dist/bin/agent-workflow.js quality:staged",
    "quality:syntax": "node dist/bin/agent-workflow.js quality:syntax",
    "quality:tasks": "node dist/bin/agent-workflow.js quality:tasks",
    "quality:workflow": "node dist/bin/agent-workflow.js quality:workflow",
    "quality:all": "npm run build && node dist/bin/agent-workflow.js quality:all",
    "quality:policy": "npm run build && node dist/bin/agent-workflow.js quality:policy",
    "prepack": "npm run build",
    "pack:artifact": "npm run build && node dist/scripts/pack-artifact.js"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/gk0919/agent-workflow.git"
  },
  "publishConfig": {
    "access": "restricted",
    "registry": "https://npm.pkg.github.com"
  },
  "files": [
    "dist/",
    "docs/",
    "examples/",
    "resources/",
    "tests/fixtures/",
    "migrations/",
    "README.md",
    "CHANGELOG.md"
  ],
  "license": "UNLICENSED",
  "devDependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@types/node": "^26.4.0",
    "rimraf": "^6.1.3",
    "typescript": "^7.0.2"
  },
  "peerDependencies": {
    "@modelcontextprotocol/client": "^2.0.0"
  },
  "peerDependenciesMeta": {
    "@modelcontextprotocol/client": {
      "optional": true
    }
  },
  "dependencies": {
    "ajv": "^8.20.0",
    "ajv-formats": "^3.0.1"
  }
}
