{
  "$schema": "../../schemas/workflow-profile.schema.json",
  "schemaVersion": 1,
  "id": "default",
  "description": "供尚未配置项目专属工作流 Profile 的仓库使用的可移植默认值。",
  "taskModel": {
    "intentRoutes": {
      "analysis": ["task-analysis", "capture"],
      "architecture": ["level-4", "capture"],
      "change": null,
      "cosmetic": null,
      "defect": null,
      "git-only": ["task-git", "inspect"],
      "pool-capture": ["task-pool-capture", "capture"],
      "portable-resume": ["task-portable-resume", "resume"],
      "requirement": null,
      "review": ["task-review", "capture"],
      "workflow-maintenance": ["task-workflow-maintenance", "inspect"]
    },
    "changeIntents": ["change", "cosmetic", "defect", "requirement"],
    "changeTypes": ["cosmetic", "defect", "requirement"],
    "changeTypeByIntent": {
      "cosmetic": "cosmetic",
      "defect": "defect",
      "requirement": "requirement"
    },
    "evolutionaryChangeTypes": ["requirement"],
    "changeStages": {
      "cosmetic": "locate-cosmetic",
      "defect": "locate-defect",
      "requirement": "locate-requirement"
    },
    "changeEntryModes": ["direct", "pool"],
    "expectedIntentEntries": {
      "git-only": ["not-applicable"],
      "pool-capture": ["pool"],
      "workflow-maintenance": ["not-applicable"]
    },
    "artifactEntryModes": ["direct", "pool"],
    "sourceTypes": ["architecture", "defect", "requirement"],
    "providerEntryMode": "pool",
    "sourceCaptureStage": "Source Capture",
    "intakeStage": "Intake",
    "knownStages": [
      "Source Capture",
      "Intake",
      "Inspect",
      "Analyze",
      "PRD",
      "Spec",
      "Design Review",
      "Architecture Review",
      "Milestones",
      "Plan",
      "Multi-Repo Sync",
      "Implement",
      "Review",
      "Verify",
      "Git Inspect"
    ]
  },
  "sourceProviders": {
    "direct": {
      "kind": "conversation"
    },
    "pool": {
      "kind": "connector",
      "name": "project-source-provider"
    }
  },
  "review": {
    "defaultSkill": ""
  },
  "capabilitySkills": {
    "handoff": "workflow:resources/skills/task-handoff/SKILL.md"
  },
  "issueTracking": {
    "enabled": false,
    "pattern": "",
    "flags": "i",
    "requiredForTypes": ["feat", "fix"],
    "enforceEnvironment": "",
    "label": "issue"
  },
  "evals": {
    "routeCases": "workflow:resources/profiles/default/evals/route-cases.json"
  },
  "governance": {
    "requiredPaths": [],
    "markdownFiles": ["AGENTS.md"],
    "markdownRoots": [],
    "denyEagerDocs": [],
    "forbiddenStagedPatterns": [],
    "deprecatedReferences": []
  },
  "setup": {
    "requiredPaths": []
  }
}
