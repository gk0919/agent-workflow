{
  "$schema": "../node_modules/@gk0919/agent-workflow/resources/schemas/workflow-config.schema.json",
  "schemaVersion": 1,
  "activeProfile": "workflow:resources/profiles/default/profile.json",
  "plugins": [
    {
      "id": "mcp-source-provider",
      "module": "@gk0919/agent-workflow/plugins/mcp-source-provider",
      "permissions": ["network:connect", "secrets:read"],
      "options": {
        "endpoint": "https://mcp.example.com/mcp",
        "allowInsecureHttp": false,
        "tokenEnv": "PROJECT_MCP_TOKEN",
        "sourceType": "project-mcp",
        "routes": {
          "requirement": {
            "tool": "query_requirement",
            "referencePattern": "^REQ-"
          },
          "defect": {
            "tool": "query_bug",
            "referencePattern": "^BUG-"
          }
        }
      }
    }
  ],
  "paths": {
    "knowledgeRoot": ".agent-workflow/profile/knowledge",
    "skillsRoot": ".agents/skills",
    "tasksRoot": ".agent-workflow/tasks/local",
    "runtimeRoot": ".agent-workflow/runtime"
  }
}
