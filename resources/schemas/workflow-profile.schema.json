{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/workflow-profile.schema.json",
  "title": "Agent Workflow Project Profile",
  "type": "object",
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "extends": {"type": "string", "minLength": 1},
    "id": {"$ref": "#/$defs/id"},
    "description": {"type": "string", "minLength": 1},
    "taskModel": {
      "type": "object",
      "properties": {
        "intentRoutes": {
          "type": "object",
          "minProperties": 1,
          "additionalProperties": {
            "oneOf": [
              {"type": "null"},
              {
                "type": "array",
                "prefixItems": [
                  {"$ref": "#/$defs/id"},
                  {"$ref": "#/$defs/id"}
                ],
                "items": false,
                "minItems": 2,
                "maxItems": 2
              }
            ]
          }
        },
        "changeIntents": {"$ref": "#/$defs/idList"},
        "changeTypes": {"$ref": "#/$defs/idList"},
        "changeTypeByIntent": {"$ref": "#/$defs/idMap"},
        "evolutionaryChangeTypes": {"$ref": "#/$defs/idList"},
        "microStages": {"$ref": "#/$defs/idMap"},
        "changeEntryModes": {"$ref": "#/$defs/idList"},
        "expectedIntentEntries": {
          "type": "object",
          "additionalProperties": {"$ref": "#/$defs/idList"}
        },
        "artifactEntryModes": {"$ref": "#/$defs/idList"},
        "sourceTypes": {"$ref": "#/$defs/idList"},
        "providerEntryMode": {"$ref": "#/$defs/id"},
        "sourceCaptureStage": {"type": "string", "minLength": 1},
        "intakeStage": {"type": "string", "minLength": 1},
        "knownStages": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {"type": "string", "minLength": 1}
        }
      },
      "additionalProperties": false
    },
    "sourceProviders": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["kind"],
        "properties": {
          "kind": {"$ref": "#/$defs/id"},
          "name": {"type": "string"}
        },
        "additionalProperties": false
      }
    },
    "review": {
      "type": "object",
      "properties": {"defaultSkill": {"type": "string"}},
      "additionalProperties": false
    },
    "issueTracking": {
      "type": "object",
      "properties": {
        "enabled": {"type": "boolean"},
        "pattern": {"type": "string"},
        "flags": {"type": "string"},
        "requiredForTypes": {"$ref": "#/$defs/idList"},
        "enforceEnvironment": {"type": "string"},
        "label": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "evals": {
      "type": "object",
      "properties": {
        "routeCases": {"type": "string", "minLength": 1}
      },
      "additionalProperties": false
    },
    "governance": {
      "type": "object",
      "properties": {
        "requiredPaths": {"$ref": "#/$defs/stringList"},
        "markdownFiles": {"$ref": "#/$defs/stringList"},
        "markdownRoots": {"$ref": "#/$defs/stringList"},
        "denyEagerDocs": {"$ref": "#/$defs/stringList"},
        "forbiddenStagedPatterns": {"$ref": "#/$defs/stringList"},
        "deprecatedReferences": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": false
    },
    "setup": {
      "type": "object",
      "properties": {
        "requiredPaths": {"$ref": "#/$defs/stringList"}
      },
      "additionalProperties": false
    }
  },
  "allOf": [
    {
      "if": {"required": ["extends"]},
      "then": {
        "required": ["schemaVersion", "extends", "id", "description"]
      },
      "else": {
        "required": [
          "schemaVersion",
          "id",
          "description",
          "taskModel",
          "sourceProviders",
          "review",
          "issueTracking",
          "evals",
          "governance",
          "setup"
        ],
        "properties": {
          "taskModel": {
            "required": [
              "intentRoutes",
              "changeIntents",
              "changeTypes",
              "changeTypeByIntent",
              "evolutionaryChangeTypes",
              "microStages",
              "changeEntryModes",
              "expectedIntentEntries",
              "artifactEntryModes",
              "sourceTypes",
              "providerEntryMode",
              "sourceCaptureStage",
              "intakeStage",
              "knownStages"
            ]
          },
          "review": {"required": ["defaultSkill"]},
          "issueTracking": {
            "required": [
              "enabled",
              "pattern",
              "flags",
              "requiredForTypes",
              "enforceEnvironment",
              "label"
            ]
          },
          "evals": {"required": ["routeCases"]},
          "governance": {
            "required": [
              "requiredPaths",
              "markdownFiles",
              "markdownRoots",
              "denyEagerDocs",
              "forbiddenStagedPatterns",
              "deprecatedReferences"
            ]
          },
          "setup": {"required": ["requiredPaths"]}
        }
      }
    }
  ],
  "$defs": {
    "id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "idList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/id"}
    },
    "idMap": {
      "type": "object",
      "additionalProperties": {"$ref": "#/$defs/id"}
    },
    "stringList": {
      "type": "array",
      "uniqueItems": true,
      "items": {"type": "string"}
    }
  },
  "additionalProperties": false
}
