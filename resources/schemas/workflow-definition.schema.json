{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/workflow-definition.schema.json",
  "title": "Portable Multi-Agent Workflow Definition",
  "description": "Portable declarative workflow graph for deterministic, bounded and recoverable execution.",
  "type": "object",
  "required": ["schemaVersion", "id", "limits", "nodes", "resultNode"],
  "properties": {
    "$schema": {"type": "string", "maxLength": 500},
    "schemaVersion": {"const": 1},
    "id": {"$ref": "#/$defs/identifier"},
    "description": {"type": "string", "minLength": 1, "maxLength": 500},
    "inputSchema": {"$ref": "#/$defs/schemaValue"},
    "limits": {"$ref": "#/$defs/limits"},
    "nodes": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {
        "oneOf": [
          {"$ref": "#/$defs/agentNode"},
          {"$ref": "#/$defs/checkpointNode"},
          {"$ref": "#/$defs/gateNode"},
          {"$ref": "#/$defs/integratorNode"},
          {"$ref": "#/$defs/joinNode"},
          {"$ref": "#/$defs/mapNode"},
          {"$ref": "#/$defs/parallelNode"},
          {"$ref": "#/$defs/reduceNode"}
        ]
      }
    },
    "resultNode": {"$ref": "#/$defs/identifier"}
  },
  "additionalProperties": false,
  "$defs": {
    "identifier": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "capability": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:[.:/-][a-z0-9]+)*$"
    },
    "schemaValue": {
      "oneOf": [
        {"type": "boolean"},
        {"type": "object"}
      ]
    },
    "jsonPointer": {
      "type": "string",
      "maxLength": 500,
      "pattern": "^(?:/(?:[^~/]|~[01])*)*$"
    },
    "dependencyList": {
      "type": "array",
      "maxItems": 200,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/identifier"}
    },
    "capabilityList": {
      "type": "array",
      "maxItems": 50,
      "uniqueItems": true,
      "items": {"$ref": "#/$defs/capability"}
    },
    "permissionList": {
      "type": "array",
      "maxItems": 8,
      "uniqueItems": true,
      "items": {
        "enum": [
          "workspace:read",
          "workspace:write",
          "process:spawn",
          "network:connect",
          "secrets:read",
          "artifact:read",
          "artifact:write",
          "telemetry:emit"
        ]
      }
    },
    "limits": {
      "type": "object",
      "required": [
        "maxAgents",
        "maxAttemptsPerNode",
        "maxConcurrency",
        "maxDurationMs",
        "maxExternalWrites",
        "maxIterations"
      ],
      "properties": {
        "maxAgents": {"type": "integer", "minimum": 1, "maximum": 1000},
        "maxAttemptsPerNode": {"type": "integer", "minimum": 1, "maximum": 10},
        "maxConcurrency": {"type": "integer", "minimum": 1, "maximum": 64},
        "maxDurationMs": {"type": "integer", "minimum": 1000, "maximum": 86400000},
        "maxExternalWrites": {"type": "integer", "minimum": 0, "maximum": 100},
        "maxIterations": {"type": "integer", "minimum": 1, "maximum": 100}
      },
      "additionalProperties": false
    },
    "nodeBase": {
      "type": "object",
      "required": ["id", "type"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "type": {"enum": ["agent", "checkpoint", "gate", "integrator", "join", "map", "parallel", "reduce"]},
        "label": {"type": "string", "minLength": 1, "maxLength": 200},
        "dependsOn": {"$ref": "#/$defs/dependencyList"}
      }
    },
    "workspace": {
      "type": "object",
      "required": ["mode"],
      "properties": {
        "mode": {"enum": ["shared-readonly", "exclusive-worktree"]},
        "repository": {"type": "string", "minLength": 1, "maxLength": 200}
      },
      "additionalProperties": false
    },
    "repositoryPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200,
      "pattern": "^(?:\\.|[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
    },
    "ownedPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9._{}-]+(?:/[A-Za-z0-9._{}-]+)*$"
    },
    "resourceKey": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9._{}:@#/-]+$"
    },
    "effect": {
      "type": "object",
      "required": ["kind", "approvalCheckpoint"],
      "properties": {
        "kind": {"enum": ["repository-write", "external-write"]},
        "approvalCheckpoint": {"$ref": "#/$defs/identifier"},
        "ownedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 50,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/ownedPath"}
        },
        "resourceLocks": {
          "type": "array",
          "minItems": 1,
          "maxItems": 200,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/resourceKey"}
        }
      },
      "additionalProperties": false
    },
    "agentNode": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/nodeBase"},
        {
          "type": "object",
          "required": ["prompt"],
          "properties": {
            "type": {"const": "agent"},
            "effect": {"$ref": "#/$defs/effect"},
            "failurePolicy": {"enum": ["fail-fast", "isolate"]},
            "prompt": {"type": "string", "minLength": 1, "maxLength": 20000},
            "outputSchema": {"$ref": "#/$defs/schemaValue"},
            "permissions": {"$ref": "#/$defs/permissionList"},
            "requiredCapabilities": {"$ref": "#/$defs/capabilityList"},
            "preferredCapabilities": {"$ref": "#/$defs/capabilityList"},
            "workspace": {"$ref": "#/$defs/workspace"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "checkpointNode": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/nodeBase"},
        {
          "type": "object",
          "required": ["approvalSummary", "dependsOn"],
          "properties": {
            "type": {"const": "checkpoint"},
            "approvalSummary": {"type": "string", "minLength": 1, "maxLength": 500},
            "dependsOn": {"$ref": "#/$defs/nonEmptyDependencyList"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "gateNode": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/nodeBase"},
        {
          "type": "object",
          "required": ["condition", "dependsOn"],
          "properties": {
            "type": {"const": "gate"},
            "condition": {"enum": ["all-completed", "all-succeeded"]},
            "dependsOn": {"$ref": "#/$defs/nonEmptyDependencyList"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "joinNode": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/nodeBase"},
        {
          "type": "object",
          "required": ["dependsOn"],
          "properties": {
            "type": {"const": "join"},
            "dependsOn": {"$ref": "#/$defs/nonEmptyDependencyList"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "integratorNode": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/nodeBase"},
        {
          "type": "object",
          "required": ["approvalCheckpoint", "dependsOn", "repository"],
          "properties": {
            "type": {"const": "integrator"},
            "approvalCheckpoint": {"$ref": "#/$defs/identifier"},
            "dependsOn": {"$ref": "#/$defs/nonEmptyDependencyList"},
            "repository": {"$ref": "#/$defs/repositoryPath"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "mapNode": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/nodeBase"},
        {
          "type": "object",
          "required": ["dependsOn", "maxItems", "prompt"],
          "properties": {
            "type": {"const": "map"},
            "effect": {"$ref": "#/$defs/effect"},
            "dependsOn": {"$ref": "#/$defs/singleDependencyList"},
            "failurePolicy": {"enum": ["fail-fast", "isolate"]},
            "itemsPointer": {"$ref": "#/$defs/jsonPointer"},
            "maxItems": {"type": "integer", "minimum": 1, "maximum": 1000},
            "prompt": {"type": "string", "minLength": 1, "maxLength": 20000},
            "outputSchema": {"$ref": "#/$defs/schemaValue"},
            "permissions": {"$ref": "#/$defs/permissionList"},
            "requiredCapabilities": {"$ref": "#/$defs/capabilityList"},
            "preferredCapabilities": {"$ref": "#/$defs/capabilityList"},
            "workspace": {"$ref": "#/$defs/workspace"}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "parallelNode": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/nodeBase"},
        {
          "type": "object",
          "required": ["dependsOn", "mode"],
          "properties": {
            "type": {"const": "parallel"},
            "dependsOn": {"$ref": "#/$defs/nonEmptyDependencyList"},
            "mode": {"enum": ["adversarial", "independent"]},
            "minSuccess": {"type": "integer", "minimum": 0, "maximum": 200}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "reduceNode": {
      "type": "object",
      "allOf": [
        {"$ref": "#/$defs/nodeBase"},
        {
          "type": "object",
          "required": ["dependsOn", "strategy"],
          "properties": {
            "type": {"const": "reduce"},
            "dependsOn": {"$ref": "#/$defs/nonEmptyDependencyList"},
            "itemsPointer": {"$ref": "#/$defs/jsonPointer"},
            "strategy": {"enum": ["collect", "dedupe"]}
          }
        }
      ],
      "unevaluatedProperties": false
    },
    "nonEmptyDependencyList": {
      "type": "array",
      "allOf": [
        {"$ref": "#/$defs/dependencyList"},
        {"type": "array", "minItems": 1}
      ]
    },
    "singleDependencyList": {
      "type": "array",
      "allOf": [
        {"$ref": "#/$defs/dependencyList"},
        {"type": "array", "minItems": 1, "maxItems": 1}
      ]
    }
  }
}
