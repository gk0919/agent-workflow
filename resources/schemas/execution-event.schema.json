{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/execution-event.schema.json",
  "title": "Multi-Agent Execution Journal Event",
  "description": "Versioned append-only event envelope reserved for the execution kernel.",
  "type": "object",
  "required": [
    "schemaVersion",
    "eventId",
    "runId",
    "workflowId",
    "workflowHash",
    "sequence",
    "timestamp",
    "type",
    "payload"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "eventId": {
      "type": "string",
      "pattern": "^event-[a-z0-9]{16,64}$"
    },
    "eventHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "previousEventHash": {
      "oneOf": [
        {"type": "null"},
        {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      ]
    },
    "runId": {
      "type": "string",
      "pattern": "^run-[a-z0-9]{16,64}$"
    },
    "workflowId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "workflowHash": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "sequence": {"type": "integer", "minimum": 0},
    "timestamp": {"type": "string", "format": "date-time"},
    "type": {
      "enum": [
        "run.created",
        "run.started",
        "node.scheduled",
        "node.started",
        "node.output-validated",
        "node.completed",
        "node.failed",
        "node.retry-scheduled",
        "run.checkpointed",
        "run.paused",
        "run.resumed",
        "run.cancelled",
        "run.completed",
        "run.failed"
      ]
    },
    "nodeId": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120,
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "attempt": {"type": "integer", "minimum": 1, "maximum": 10},
    "payload": {
      "type": "object",
      "maxProperties": 100
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "type": {
            "enum": [
              "node.scheduled",
              "node.started",
              "node.output-validated",
              "node.completed",
              "node.failed",
              "node.retry-scheduled"
            ]
          }
        },
        "required": ["type"]
      },
      "then": {
        "type": "object",
        "required": ["nodeId", "attempt"],
        "properties": {
          "nodeId": true,
          "attempt": true
        }
      },
      "else": {
        "type": "object",
        "properties": {
          "nodeId": false,
          "attempt": false
        }
      }
    }
  ],
  "additionalProperties": false
}
