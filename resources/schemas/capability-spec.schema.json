{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/capability-spec.json",
  "title": "Capability behavior baseline v1",
  "type": "object",
  "additionalProperties": false,
  "required": ["schemaVersion", "capability", "status", "evidence", "requirements"],
  "properties": {
    "schemaVersion": { "const": 1 },
    "capability": { "type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$" },
    "status": { "enum": ["confirmed", "observed", "unknown"] },
    "evidence": { "type": "array", "maxItems": 100, "items": { "$ref": "#/$defs/text" } },
    "requirements": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "$ref": "#/$defs/requirement" } }
  },
  "allOf": [
    { "if": { "properties": { "status": { "const": "confirmed" } } }, "then": { "properties": { "evidence": { "type": "array", "minItems": 1 } } } }
  ],
  "$defs": {
    "text": { "type": "string", "minLength": 1, "maxLength": 4000, "pattern": "\\S" },
    "requirement": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "statement", "scenarios"],
      "properties": {
        "id": { "type": "string", "pattern": "^R[1-9][0-9]*$" },
        "statement": { "$ref": "#/$defs/text" },
        "scenarios": {
          "type": "array", "minItems": 1, "maxItems": 30,
          "items": {
            "type": "object", "additionalProperties": false,
            "required": ["id", "when", "then"],
            "properties": {
              "id": { "type": "string", "pattern": "^S[1-9][0-9]*$" },
              "given": { "$ref": "#/$defs/text" },
              "when": { "$ref": "#/$defs/text" },
              "then": { "$ref": "#/$defs/text" }
            }
          }
        }
      }
    }
  }
}
