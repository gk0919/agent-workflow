{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/workflow-config.schema.json",
  "title": "Agent Workflow Host Configuration",
  "type": "object",
  "required": ["schemaVersion", "activeProfile", "paths"],
  "properties": {
    "$schema": {"type": "string"},
    "schemaVersion": {"const": 1},
    "activeProfile": {"$ref": "#/$defs/relativePath"},
    "paths": {
      "type": "object",
      "required": ["knowledgeRoot", "skillsRoot", "tasksRoot", "runtimeRoot"],
      "properties": {
        "knowledgeRoot": {"$ref": "#/$defs/relativePath"},
        "skillsRoot": {"$ref": "#/$defs/relativePath"},
        "tasksRoot": {"$ref": "#/$defs/relativePath"},
        "runtimeRoot": {"$ref": "#/$defs/relativePath"}
      },
      "additionalProperties": false
    },
    "plugins": {
      "type": "array",
      "items": {"$ref": "#/$defs/plugin"}
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "permission": {
      "enum": [
        "workspace:read",
        "workspace:write",
        "process:spawn",
        "network:connect",
        "artifact:read",
        "artifact:write",
        "telemetry:emit"
      ]
    },
    "plugin": {
      "type": "object",
      "required": ["id", "module"],
      "properties": {
        "id": {"$ref": "#/$defs/identifier"},
        "module": {"type": "string", "minLength": 1},
        "enabled": {"type": "boolean", "default": true},
        "permissions": {
          "type": "array",
          "items": {"$ref": "#/$defs/permission"},
          "uniqueItems": true
        },
        "options": {"type": "object"}
      },
      "additionalProperties": false
    },
    "relativePath": {
      "type": "string",
      "minLength": 1,
      "pattern": "^(?![A-Za-z]:[\\\\/])(?![\\\\/])(?!.*(?:^|[\\\\/])\\.\\.(?:[\\\\/]|$)).+$"
    }
  },
  "additionalProperties": false
}
