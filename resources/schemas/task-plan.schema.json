{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/task-plan.schema.json",
  "title": "Persistent Task Work Items",
  "type": "object",
  "required": ["version", "taskId", "items"],
  "properties": {
    "version": {"const": 1},
    "taskId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "items": {
      "type": "array",
      "minItems": 1,
      "maxItems": 200,
      "items": {"$ref": "#/$defs/workItem"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "line": {"type": "string", "maxLength": 2000, "pattern": "^[^\\r\\n]*$"},
    "nonemptyLine": {"type": "string", "minLength": 1, "maxLength": 2000, "pattern": "^(?=.*\\S)[^\\r\\n]*$"},
    "workItem": {
      "type": "object",
      "required": ["id", "title", "stage", "complete", "progress", "plannedChangeIds", "verificationIds", "dependencies", "doneWhen", "evidence", "checkpoint", "blocker", "artifact", "deferred", "deferredReason"],
      "properties": {
        "id": {"type": "string", "pattern": "^T[1-9][0-9]*$"},
        "title": {"$ref": "#/$defs/nonemptyLine"},
        "stage": {"$ref": "#/$defs/nonemptyLine"},
        "complete": {"type": "boolean"},
        "progress": {"enum": ["pending", "active", "blocked"]},
        "plannedChangeIds": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^C[1-9][0-9]*$"}},
        "verificationIds": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"type": "string", "pattern": "^VT[1-9][0-9]*$"}},
        "dependencies": {"type": "array", "maxItems": 200, "uniqueItems": true, "items": {"type": "string", "pattern": "^T[1-9][0-9]*$"}},
        "doneWhen": {"$ref": "#/$defs/nonemptyLine"},
        "evidence": {"type": "array", "maxItems": 100, "uniqueItems": true, "items": {"$ref": "#/$defs/nonemptyLine"}},
        "checkpoint": {"$ref": "#/$defs/line"},
        "blocker": {"$ref": "#/$defs/line"},
        "artifact": {"$ref": "#/$defs/line"},
        "deferred": {"type": "boolean"},
        "deferredReason": {"$ref": "#/$defs/line"}
      },
      "additionalProperties": false
    }
  }
}
