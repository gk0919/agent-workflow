{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/verification-contract.schema.json",
  "title": "AI Workflow Goal and Verification Contract",
  "type": "object",
  "required": [
    "schemaVersion",
    "taskId",
    "contractStatus",
    "goals",
    "acceptanceCriteria",
    "outOfScope",
    "plannedChanges",
    "actualChanges",
    "testPoints"
  ],
  "properties": {
    "schemaVersion": {"const": 1},
    "taskId": {"type": "string", "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"},
    "contractStatus": {
      "enum": ["planned", "implemented", "verified", "conditional"]
    },
    "goals": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": {"type": "string", "pattern": "^G[1-9][0-9]*$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "additionalProperties": false
      }
    },
    "acceptanceCriteria": {
      "type": "array",
      "minItems": 1,
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "goalIds", "statement"],
        "properties": {
          "id": {"type": "string", "pattern": "^AC[1-9][0-9]*$"},
          "goalIds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^G[1-9][0-9]*$"},
            "uniqueItems": true
          },
          "statement": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "additionalProperties": false
      }
    },
    "outOfScope": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "object",
        "required": ["id", "statement"],
        "properties": {
          "id": {"type": "string", "pattern": "^OOS[1-9][0-9]*$"},
          "statement": {"type": "string", "minLength": 1, "maxLength": 500}
        },
        "additionalProperties": false
      }
    },
    "plannedChanges": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": ["id", "repository", "path", "summary", "acceptanceIds"],
        "properties": {
          "id": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
          "repository": {"type": "string", "minLength": 1, "maxLength": 200},
          "path": {"type": "string", "minLength": 1, "maxLength": 300},
          "summary": {"type": "string", "minLength": 1, "maxLength": 500},
          "acceptanceIds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^AC[1-9][0-9]*$"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "actualChanges": {
      "type": "array",
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "repository",
          "path",
          "summary",
          "plannedChangeIds",
          "acceptanceIds"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^A[1-9][0-9]*$"},
          "repository": {"type": "string", "minLength": 1, "maxLength": 200},
          "path": {"type": "string", "minLength": 1, "maxLength": 300},
          "summary": {"type": "string", "minLength": 1, "maxLength": 500},
          "plannedChangeIds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^C[1-9][0-9]*$"},
            "uniqueItems": true
          },
          "acceptanceIds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^AC[1-9][0-9]*$"},
            "uniqueItems": true
          }
        },
        "additionalProperties": false
      }
    },
    "testPoints": {
      "type": "array",
      "minItems": 1,
      "maxItems": 100,
      "items": {
        "type": "object",
        "required": [
          "id",
          "acceptanceIds",
          "method",
          "executor",
          "instructions",
          "expected",
          "status",
          "evidence",
          "blocker"
        ],
        "properties": {
          "id": {"type": "string", "pattern": "^VT[1-9][0-9]*$"},
          "acceptanceIds": {
            "type": "array",
            "minItems": 1,
            "items": {"type": "string", "pattern": "^AC[1-9][0-9]*$"},
            "uniqueItems": true
          },
          "method": {
            "enum": [
              "static",
              "mcp-playwright",
              "mcp-other",
              "cli",
              "ci",
              "manual",
              "not-verifiable"
            ]
          },
          "executor": {"enum": ["agent", "human", "ci"]},
          "instructions": {"type": "string", "minLength": 1, "maxLength": 1000},
          "expected": {"type": "string", "minLength": 1, "maxLength": 1000},
          "status": {
            "enum": ["planned", "passed", "failed", "blocked", "not-applicable"]
          },
          "capability": {
            "type": "object",
            "required": ["available", "authorized", "environmentReady"],
            "properties": {
              "available": {"enum": ["yes", "no", "unknown"]},
              "authorized": {"enum": ["yes", "no", "unknown"]},
              "environmentReady": {"enum": ["yes", "no", "unknown"]}
            },
            "additionalProperties": false
          },
          "evidence": {
            "type": "array",
            "maxItems": 20,
            "items": {"type": "string", "minLength": 1, "maxLength": 500}
          },
          "blocker": {"type": "string", "maxLength": 500}
        },
        "additionalProperties": false
      }
    }
  },
  "additionalProperties": false
}
