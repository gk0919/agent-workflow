{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agent-workflow.local/schemas/execution-workspace-state.schema.json",
  "title": "Execution Workspace Runtime State",
  "description": "Host-local state for Run/Node/Lane Git worktree bindings. Absolute paths are not portable.",
  "type": "object",
  "required": ["schemaVersion", "runId", "updatedAt", "bindings"],
  "properties": {
    "schemaVersion": {"const": 1},
    "runId": {"type": "string", "pattern": "^run-[a-z0-9]{16,64}$"},
    "updatedAt": {"type": "string", "format": "date-time"},
    "bindings": {
      "type": "array",
      "maxItems": 1000,
      "items": {"$ref": "#/$defs/binding"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "artifact": {
      "type": "object",
      "required": ["byteLength", "id", "mediaType", "sha256"],
      "properties": {
        "byteLength": {"type": "integer", "minimum": 0},
        "id": {"type": "string", "minLength": 1},
        "mediaType": {"const": "application/json"},
        "sha256": {"type": "string", "pattern": "^[a-f0-9]{64}$"}
      },
      "additionalProperties": false
    },
    "finding": {
      "type": "object",
      "required": ["code", "message", "severity"],
      "properties": {
        "code": {"type": "string", "minLength": 1, "maxLength": 120},
        "message": {"type": "string", "minLength": 1, "maxLength": 2000},
        "severity": {"enum": ["error", "info", "warning"]}
      },
      "additionalProperties": false
    },
    "targetPath": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^[A-Za-z0-9._{}-]+(?:/[A-Za-z0-9._{}-]+)*$"
    },
    "binding": {
      "type": "object",
      "required": [
        "baseCommit",
        "bindingId",
        "changedPaths",
        "commit",
        "conflicts",
        "effectId",
        "findings",
        "nodeId",
        "ownedPaths",
        "outputArtifact",
        "purpose",
        "repository",
        "rootPath",
        "state"
      ],
      "properties": {
        "baseCommit": {"type": "string", "pattern": "^[a-f0-9]{40,64}$"},
        "bindingId": {"type": "string", "minLength": 1, "maxLength": 1024},
        "changedPaths": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/targetPath"}
        },
        "commit": {
          "type": ["string", "null"],
          "pattern": "^[a-f0-9]{40,64}$"
        },
        "conflicts": {
          "type": "array",
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/targetPath"}
        },
        "effectId": {"type": ["string", "null"], "maxLength": 500},
        "findings": {
          "type": "array",
          "maxItems": 100,
          "items": {"$ref": "#/$defs/finding"}
        },
        "laneId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "nodeId": {
          "type": "string",
          "minLength": 1,
          "maxLength": 120,
          "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
        },
        "ownedPaths": {
          "type": "array",
          "minItems": 1,
          "maxItems": 5000,
          "uniqueItems": true,
          "items": {"$ref": "#/$defs/targetPath"}
        },
        "outputArtifact": {
          "oneOf": [
            {"type": "null"},
            {"$ref": "#/$defs/artifact"}
          ]
        },
        "purpose": {"enum": ["agent", "integrator"]},
        "repository": {
          "type": "string",
          "minLength": 1,
          "maxLength": 200,
          "pattern": "^(?:\\.|[A-Za-z0-9._-]+(?:/[A-Za-z0-9._-]+)*)$"
        },
        "rootPath": {"type": "string", "minLength": 1},
        "state": {
          "enum": [
            "active",
            "conflicted",
            "finalized",
            "finalizing",
            "verification-failed"
          ]
        }
      },
      "additionalProperties": false
    }
  }
}
